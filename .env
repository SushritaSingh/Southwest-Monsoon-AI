# General Configurations
ENV_STATE=development
LOG_LEVEL=INFO

# Open-Meteo / Public Weather APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Generative AI & Vector Settings (Ollama local inference setup)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LLM_MODEL_NAME=llama3  # Options: gemma, qwen, mistral, phi
VECTOR_DB_PATH=data/vector_db

# Mapbox / GIS tokens (Optional, fallback defaults to Leaflet)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here